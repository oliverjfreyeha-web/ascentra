# Copy to .env.local and fill in. All are required; the server will not start without them.

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk. Only the publishable key is public (it is built into the page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# The one Owner account, seeded once on the first verified sign-in with this email.
OWNER_EMAIL=

# Vercel Cron authenticates to /api/cron/* with this (32+ random characters). Server-only.
CRON_SECRET=

# Stripe (B1). Sandbox (test mode) only for now. Missing values switch billing off (503), not the site.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
# From `npm run stripe:setup` (ids, not secrets).
STRIPE_PRICE_BASIC=
STRIPE_PRICE_PRO=
STRIPE_PORTAL_CONFIG=

# B4: email notices through Resend. Optional: when missing, notices are recorded as skipped (the site keeps working).
# RESEND_API_KEY is a secret (re_…). NOTICE_FROM_EMAIL is an address on a domain verified in Resend,
# e.g. ASCENTRA <notices@your-domain>.
RESEND_API_KEY=
NOTICE_FROM_EMAIL=

# L1: AI. Optional: without ANTHROPIC_API_KEY, AI features are off and the rest of the site works.
# ANTHROPIC_API_KEY: console.anthropic.com → Settings → API keys (sk-ant-…). Secret.
# VOYAGE_API_KEY: dashboard.voyageai.com → API keys (pa-…). Secret. Without it, source search uses full-text ranking only.
ANTHROPIC_API_KEY=
VOYAGE_API_KEY=
# Optional, plain numbers in US dollars: override the placeholder spend caps in lib/ai/config.ts.
AI_DAILY_CAP_USD=
AI_MONTHLY_CAP_USD=
