# Copy to .env.local and fill in. All are required; the server will not start without them.

# Supabase (server-only)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=

# Clerk. Only the publishable key is public (it is built into the page).
NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY=
CLERK_SECRET_KEY=
CLERK_WEBHOOK_SIGNING_SECRET=

# The one Owner account, seeded once on the first verified sign-in with this email.
OWNER_EMAIL=

# Vercel Cron authenticates to /api/cron/* with this (32+ random characters). Server-only.
CRON_SECRET=
